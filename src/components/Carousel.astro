---
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";

import { MAX_HERO_WIDTH } from "@constants";

import { styles } from "./Carousel.styles";

interface Props {
  photos: ImageMetadata[];
  name: string;
  style?: StyleXStyles;
}

const { photos, name, style } = Astro.props;
const totalPhotos = photos.length;

const wrapperAttrs = stylex.attrs(styles.wrapper, style);
const trackAttrs = stylex.attrs(styles.track);
const slideAttrs = stylex.attrs(styles.slide);
const imageAttrs = stylex.attrs(styles.image);
const counterAttrs = stylex.attrs(styles.counter);
---

<div {...wrapperAttrs} data-carousel>
  <ul {...trackAttrs} data-carousel-track>
    {
      photos.map((photo) => (
        <li class={slideAttrs.class} style={slideAttrs.style}>
          <Image
            src={photo}
            alt={`Photo of ${name}`}
            width={MAX_HERO_WIDTH}
            class={imageAttrs.class}
            style={imageAttrs.style}
          />
        </li>
      ))
    }
  </ul>
  {
    totalPhotos > 1 && (
      <div class={counterAttrs.class} style={counterAttrs.style}>
        <span data-carousel-current>01</span>/
        <span>{totalPhotos.toString().padStart(2, "0")}</span>
      </div>
    )
  }
</div>

<script>
  import { initCarousel } from "@scripts/carousel";

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const label = root.querySelector<HTMLElement>("[data-carousel-current]");
    // The counter (and with it the label) only renders for multi-photo
    // carousels, which are the only ones that need interaction.
    if (track && label) initCarousel(track, label);
  });
</script>
