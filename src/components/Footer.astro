---
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";
import logomark from "../assets/logomark.svg";

interface Props {
  hideMarkOnDesktop?: boolean;
  hideMarkOnMobile?: boolean;
  style?: StyleXStyles;
}
import { SOCIAL_LINKS } from "src/constants";

import { styles } from "./Footer.styles";

const { instagram, email } = SOCIAL_LINKS;
const username = instagram.split("/").pop();

const {
  hideMarkOnDesktop = false,
  hideMarkOnMobile = false,
  style,
} = Astro.props;

const footerAttrs = stylex.attrs(styles.footer, style);
const contactAttrs = stylex.attrs(styles.contact);
const igAttrs = stylex.attrs(styles.ig);
const addressAttrs = stylex.attrs(styles.address);
const visuallyHiddenAttrs = stylex.attrs(styles.visuallyHidden);
const markAttrs = stylex.attrs(
  styles.mark,
  hideMarkOnDesktop && styles.markHiddenOnDesktop,
  hideMarkOnMobile && styles.markHiddenOnMobile
);
---

<footer {...footerAttrs}>
  <section {...contactAttrs}>
    <h2>contact</h2>
    <address {...addressAttrs}>
      <a href=`mailto:${email}`>{email}</a>
    </address>
  </section>
  <section {...igAttrs}>
    <h2>instagram</h2>
    <a href={instagram}
      >@{username}<span {...visuallyHiddenAttrs}>(Instagram Profile)</span></a
    >
  </section>
  <div {...markAttrs}>
    <Image src={logomark} alt="" width={48} height={48} />
  </div>
</footer>
