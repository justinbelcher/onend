---
import { getImage, Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";

import { MAX_HERO_WIDTH } from "@constants";
import { DESKTOP_MEDIA_QUERY } from "@constants";

import { styles } from "./HeroImage.styles";

interface Props {
  image: ImageMetadata;
  altText: string;
  /**
   * Art direction: when provided, `image` is shown on desktop and
   * `mobileImage` below the desktop breakpoint — as a single <picture>
   * element, so browsers only download the variant they display.
   */
  mobileImage?: ImageMetadata;
  style?: StyleXStyles | ReadonlyArray<StyleXStyles>;
}

const { image, altText, mobileImage, style } = Astro.props;

const sectionAttrs = stylex.attrs(style);
const imageAttrs = stylex.attrs(styles.image);

const desktopSource = mobileImage
  ? await getImage({ src: image, width: MAX_HERO_WIDTH })
  : null;
---

<section {...sectionAttrs}>
  {
    mobileImage && desktopSource ? (
      <picture>
        <source
          media={DESKTOP_MEDIA_QUERY}
          srcset={desktopSource.srcSet.attribute || desktopSource.src}
          width={desktopSource.attributes.width}
          height={desktopSource.attributes.height}
        />
        <Image
          src={mobileImage}
          alt={altText}
          width={MAX_HERO_WIDTH}
          loading="eager"
          class={imageAttrs.class}
          style={imageAttrs.style}
        />
      </picture>
    ) : (
      <Image
        src={image}
        alt={altText}
        width={MAX_HERO_WIDTH}
        loading="eager"
        class={imageAttrs.class}
        style={imageAttrs.style}
      />
    )
  }
</section>
