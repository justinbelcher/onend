---
import * as stylex from "@stylexjs/stylex";

import { styles } from "./InfoLine.styles";

interface Props {
  label: string;
  value: string | number;
}

const { label, value } = Astro.props;

const lineAttrs = stylex.attrs(styles.line);
const labelAttrs = stylex.attrs(styles.label);
const valueAttrs = stylex.attrs(styles.value);
---

<article {...lineAttrs}>
  <h2 {...labelAttrs}>{label}</h2>
  <p {...valueAttrs}>{value}</p>
</article>
