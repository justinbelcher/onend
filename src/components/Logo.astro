---
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";
import logoVertical from "../assets/logo-vertical.svg";
import logoHorizontal from "../assets/logo.svg";

import { styles } from "./Logo.styles";

interface Props {
  style?: StyleXStyles;
}

const { style } = Astro.props;

const headerAttrs = stylex.attrs(style);
const desktopAttrs = stylex.attrs(styles.desktopLogo);
const mobileAttrs = stylex.attrs(styles.mobileLogo);
---

<header {...headerAttrs}>
  <a href="/">
    <Image
      src={logoVertical}
      width={56}
      height={274}
      loading="eager"
      alt="On end studio logo"
      class={desktopAttrs.class}
      style={desktopAttrs.style}
    />
    <Image
      src={logoHorizontal}
      width={274}
      height={56}
      loading="eager"
      alt="On end studio logo"
      class={mobileAttrs.class}
      style={mobileAttrs.style}
    />
  </a>
</header>
