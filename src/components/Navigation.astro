---
import { Icon } from "astro-icon/components";
import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";

import { SOCIAL_LINKS, NAV_LINKS } from "src/constants";
import type { NavLink } from "@types";

import { styles } from "./Navigation.styles";

interface Props {
  style?: StyleXStyles;
}

const { instagram } = SOCIAL_LINKS;

const { style } = Astro.props;

const navAttrs = stylex.attrs(styles.nav, style);
const igAttrs = stylex.attrs(styles.igLink);
---

<nav {...navAttrs}>
  {
    NAV_LINKS.map((link: NavLink) => {
      const isActive = Astro.url.pathname.startsWith(link.href);
      return (
        <a
          href={link.href}
          {...stylex.attrs(styles.navLink, isActive && styles.navLinkActive)}
          aria-current={isActive ? "page" : undefined}
        >
          {link.label}
        </a>
      );
    })
  }
  <a href={instagram} {...igAttrs}
    ><Icon name="instagram" size="24" title="Instagram" /></a
  >
</nav>
