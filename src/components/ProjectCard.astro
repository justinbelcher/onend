---
import { Image } from "astro:assets";
import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";

import { MAX_GRID_WIDTH } from "@constants";

import { cardMarker, styles } from "./ProjectCard.styles";

interface Props {
  slug: string;
  name: string;
  year: number;
  image: ImageMetadata;
  style?: StyleXStyles;
}

const { slug, name, year, image, style } = Astro.props;

const cardAttrs = stylex.attrs(style, cardMarker);
const linkAttrs = stylex.attrs(styles.link);
const imageFrameAttrs = stylex.attrs(styles.imageFrame);
const imageAttrs = stylex.attrs(styles.image);
const captionAttrs = stylex.attrs(styles.caption);
const titleAttrs = stylex.attrs(styles.title);
const yearAttrs = stylex.attrs(styles.year);
---

<article {...cardAttrs}>
  <a href={`/work/${slug}`} title={`View details for ${name}`} {...linkAttrs}>
    <div {...imageFrameAttrs}>
      <Image
        src={image}
        alt={`Photo of ${name}`}
        width={MAX_GRID_WIDTH}
        class={imageAttrs.class}
        style={imageAttrs.style}
      />
    </div>
    <aside {...captionAttrs}>
      <h1 {...titleAttrs}>{name}</h1>
      <p {...yearAttrs}>{year}</p>
    </aside>
  </a>
</article>
