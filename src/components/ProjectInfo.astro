---
import * as stylex from "@stylexjs/stylex";

import InfoLine from "@components/InfoLine.astro";

import { styles } from "./ProjectInfo.styles";

interface Props {
  year: number;
  materials: string;
  finish?: string;
}
const { year, materials, finish } = Astro.props;

const sectionAttrs = stylex.attrs(styles.section);
---

<section {...sectionAttrs}>
  <InfoLine label="Year" value={year} />
  <InfoLine label="Materials" value={materials} />
  {finish && <InfoLine label="Finish" value={finish} />}
</section>
