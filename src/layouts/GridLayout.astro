---
import type { StyleXStyles } from "@stylexjs/stylex";

interface Props {
  pageTitle?: string;
  style?: StyleXStyles;
}

const { pageTitle, style } = Astro.props;

import Logo from "@components/Logo.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";

import Layout from "@layouts/Layout.astro";

import { grid } from "@styles/shared";
import { styles } from "./GridLayout.styles";
---

<Layout {pageTitle} style={[styles.areas, style]}>
  <Logo style={grid.inLogo} />
  <Navigation style={grid.inNav} />
  <slot />
  <Footer hideMarkOnDesktop={false} hideMarkOnMobile={false} />
</Layout>
