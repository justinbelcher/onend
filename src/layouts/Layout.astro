---
import "@styles/global.css";

import * as stylex from "@stylexjs/stylex";
import type { StyleXStyles } from "@stylexjs/stylex";

import {
  THEME_COLOR,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SOCIAL_IMAGE,
} from "src/constants";

import { styles } from "./Layout.styles";

interface Props {
  pageTitle?: string;
  hideGrid?: boolean;
  style?: StyleXStyles | ReadonlyArray<StyleXStyles>;
}
const { pageTitle, hideGrid = false, style } = Astro.props;
const title = pageTitle ? `${pageTitle} | ${SITE_TITLE}` : SITE_TITLE;

const bodyAttrs = stylex.attrs(styles.body);
const mainAttrs = stylex.attrs(styles.grid, style);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="description" content={SITE_DESCRIPTION.long} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION.short} />
    <meta property="og:image" content={SOCIAL_IMAGE} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;1,300&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body {...bodyAttrs}>
    {
      hideGrid ? (
        <main>
          <slot />
        </main>
      ) : (
        <main {...mainAttrs}>
          <slot />
        </main>
      )
    }
  </body>
</html>
