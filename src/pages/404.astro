---
import * as stylex from "@stylexjs/stylex";

import Layout from "@layouts/Layout.astro";
import NotFoundScene from "../components/NotFoundScene";

import { styles } from "@styles/pages/not-found";

const containerAttrs = stylex.attrs(styles.container);
const sceneAttrs = stylex.attrs(styles.scene);
const headingAttrs = stylex.attrs(styles.heading);
const pathnameAttrs = stylex.attrs(styles.pathname);
const lastLineAttrs = stylex.attrs(styles.lastLine);
---

<Layout hideGrid={true} pageTitle="404">
  <div {...containerAttrs}>
    <div {...sceneAttrs}>
      <NotFoundScene client:load />
    </div>
    <div>
      <h1 {...headingAttrs}>404</h1>
      <p>
        Hmm... I couldn't find <code id="pathname" {...pathnameAttrs}>/404</code
        >.
      </p>
      <p {...lastLineAttrs}>Head back <a href="/">home?</a></p>
    </div>
  </div>
</Layout>

<script>
  const el = document.getElementById("pathname");
  if (el) {
    el.textContent = window.location.pathname;
  }
</script>
