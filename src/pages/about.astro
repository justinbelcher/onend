---
import { getEntry, render } from "astro:content";
import * as stylex from "@stylexjs/stylex";

import PageLayout from "@layouts/PageLayout.astro";
import HeroImage from "@components/HeroImage.astro";

import headshot from "../assets/me.webp";

import { grid } from "@styles/shared";
import { styles } from "@styles/pages/about";

const bio = await getEntry("text", "bio");

if (!bio) {
  throw new Error("Bio text snippet not found");
}

const { Content: Bio } = await render(bio);

const { byline } = bio.data;

const contentAttrs = stylex.attrs(grid.inMain);
const bylineAttrs = stylex.attrs(styles.byline);
---

<PageLayout pageTitle="About">
  <section slot="content" {...contentAttrs}>
    <h1 {...bylineAttrs}>
      {byline}
    </h1>
    <Bio />
  </section>

  <HeroImage
    slot="hero"
    image={headshot}
    altText="Headshot of Justin"
    style={grid.inHero}
  />
</PageLayout>
