---
import * as stylex from "@stylexjs/stylex";

import PageLayout from "@layouts/PageLayout.astro";
import HeroImage from "@components/HeroImage.astro";

import desktopHero from "../assets/work/coffeetable-intro.jpg";
import mobileHero from "../assets/work/coffeetable-1.jpg";

import { grid } from "@styles/shared";
import { styles } from "@styles/pages/home";

const introAttrs = stylex.attrs(styles.intro);
const headlineAttrs = stylex.attrs(styles.headline);
const locationAttrs = stylex.attrs(styles.location);
---

<PageLayout>
  <section slot="content" {...introAttrs}>
    <h1 {...headlineAttrs}>
      ~~> Some really nice things for your home ¤ Made upright with care by
      Justin Belcher in <i {...locationAttrs}>San Francisco</i>.
    </h1>
  </section>

  <HeroImage
    slot="hero"
    image={desktopHero}
    mobileImage={mobileHero}
    altText="Front view of a walnut coffee table"
    style={grid.inHero}
  />
</PageLayout>
