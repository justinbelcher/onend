---
import { getCollection, render } from "astro:content";
import * as stylex from "@stylexjs/stylex";

import PageLayout from "@layouts/PageLayout.astro";

import ProjectInfo from "@components/ProjectInfo.astro";
import Carousel from "@components/Carousel.astro";

import { grid } from "@styles/shared";
import { styles } from "@styles/pages/work-detail";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.isDraft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { name, photos, year, materials, finish } = project.data;

const detailsAttrs = stylex.attrs(styles.details);
const titleAttrs = stylex.attrs(styles.title);
---

<PageLayout pageTitle={name}>
  <section slot="content" {...detailsAttrs}>
    <h1 {...titleAttrs}>{name}</h1>
    <div>
      <Content />
      <ProjectInfo {year} {materials} {finish} />
    </div>
  </section>
  <Carousel {photos} {name} slot="hero" style={grid.inHero} />
</PageLayout>
