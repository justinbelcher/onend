---
import * as stylex from "@stylexjs/stylex";

import ProjectCard from "@components/ProjectCard.astro";
import Layout from "@layouts/GridLayout.astro";

import { getOrderedProjects } from "@scripts/utils";

import { styles } from "@styles/pages/work-index";

const projects = await getOrderedProjects();

const gridAttrs = stylex.attrs(styles.projectGrid);
---

<Layout style={styles.page}>
  <section {...gridAttrs}>
    {
      projects.map((project) => (
        <ProjectCard
          slug={project.id}
          name={project.data.name}
          year={project.data.year}
          image={project.data.cover}
          style={styles.card}
        />
      ))
    }
  </section>
</Layout>
